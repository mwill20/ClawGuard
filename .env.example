# ClawGuard / OpenClaw job-search-custom environment template
# Copy values into the deployed VPS .env file; do not commit real secrets.

# Primary scraper provider
OXYLABS_AISTUDIO_API_KEY=replace_with_oxylabs_ai_studio_key

# Optional fallback providers
BRAVE_SEARCH_API_KEY=replace_with_brave_search_api_key
USAJOBS_AUTH_KEY=replace_with_usajobs_authorization_key
USAJOBS_USER_AGENT=replace_with_registered_email@example.com

# Provider control
# auto = USAJobs native for usajobs when configured, Oxylabs primary, Brave fallback
CLAWGUARD_SEARCH_PROVIDER=auto
CLAWGUARD_DISABLE_OXYLABS=0
CLAWGUARD_FALLBACK_ON_EMPTY=0
CLAWGUARD_HTTP_TIMEOUT_SECONDS=20

# Runtime paths
CLAWGUARD_DATA_DIR=/data/clawguard

# Maintenance-mode volume controls
CLAWGUARD_AUTO_PREPARE_THRESHOLD=0.75
CLAWGUARD_ENRICHMENT_DAILY_CAP=10
CLAWGUARD_DIGEST_MAX_RESULTS_PER_SITE=5
CLAWGUARD_DIGEST_TOP_MATCH_LIMIT=10

# Email digest notification
CLAWGUARD_EMAIL_FROM=replace_with_sender_email@example.com
CLAWGUARD_EMAIL_PASSWORD=replace_with_email_app_password
CLAWGUARD_EMAIL_TO=replace_with_recipient_email@example.com
CLAWGUARD_SMTP_HOST=smtp.gmail.com
CLAWGUARD_SMTP_PORT=587

# ASI06 detection tuning
CLAWGUARD_SKILL_STUFFING_THRESHOLD=15
CLAWGUARD_SKILL_STUFFING_PENALTY=0.15
